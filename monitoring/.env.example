# Monitoring Stack - Fichier de variables d'environnement d'exemple
# Copier sous .env et renseigner les valeurs réelles

# Alertmanager Discord Webhook URL (ou monter via webhook_url_file)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<REDACTED>/<REDACTED>

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<REDACTED>

# Freebox Exporter API credentials
FREEBOX_APP_ID=fr.homelab.monitoring
FREEBOX_APP_TOKEN=<REDACTED>
FREEBOX_TRACK_ID=<REDACTED>

# Home Assistant Long-Lived Access Token
HASS_TOKEN=<REDACTED>
